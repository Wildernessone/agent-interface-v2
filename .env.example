# Frontend env vars (Vite reads these at build time)

# Supabase project
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare proxy URL (the worker you deploy from infrastructure/cloudflare-proxy)
VITE_PROXY_URL=https://your-proxy.your-account.workers.dev

# Sentry (optional but recommended for production)
VITE_SENTRY_DSN=

# Dropbox app client ID (optional — only needed if you want the Dropbox
# storage provider available). Register a free app at
# https://www.dropbox.com/developers/apps with these settings:
#   - "Scoped access"
#   - "Full Dropbox" or "App folder" access
#   - Redirect URI: your app's origin (e.g. https://localhost:5173 in dev)
#   - Permissions: files.content.write, files.content.read, sharing.write
VITE_DROPBOX_CLIENT_ID=

# Reddit app client ID (optional — only needed for Reddit posting). Register an
# app at https://www.reddit.com/prefs/apps:
#   - type: "installed app"  (PKCE, no client secret needed)
#   - redirect uri: your app's origin (e.g. https://your-app.pages.dev/ , or
#     http://localhost:5173/ in dev) — must match exactly
# Paste the client id (under the app name) here. No secret is stored anywhere.
VITE_REDDIT_CLIENT_ID=
