# Frontend env vars (Vite reads these at build time)

# Supabase project
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare proxy URL (the worker you deploy from infrastructure/cloudflare-proxy)
VITE_PROXY_URL=https://your-proxy.your-account.workers.dev

# Sentry (optional but recommended for production)
VITE_SENTRY_DSN=
