# Build-time feature flags for the PRODUCTION (Cloudflare Pages) build only.
# Vite loads this during `vite build`; `npm run dev` is unaffected. Real secrets
# (VITE_SUPABASE_*, VITE_PROXY_URL) live in the Pages dashboard env, not here, and
# keep precedence over this file.

# Server-side build execution (BuildRunner Durable Object). The client routes
# eligible builds (games/webapp + doc/deck/sheet/pdf, incl. images) to the worker
# and falls back to the in-browser build on ANY error. Kill switch: set to 0.
VITE_SERVER_BUILDS=1
